{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ProcKill 默认能力",
  "windows": ["main", "tray"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-position",
    "core:window:allow-set-focus",
    "opener:default",
    "autostart:default"
  ]
}
