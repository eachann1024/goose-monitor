{
  "name": "prockill",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ProcKill — 跨平台进程管理器，支持 Tauri 桌面应用与 uTools 插件",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode utools && node scripts/build-utools.mjs",
    "mac": "node scripts/guard-platform.mjs darwin && tauri build",
    "win": "node scripts/guard-platform.mjs win32 && tauri build",
    "linux": "node scripts/guard-platform.mjs linux && tauri build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:mac": "node scripts/guard-platform.mjs darwin && tauri build",
    "build:win": "node scripts/guard-platform.mjs win32 && tauri build",
    "build:linux": "node scripts/guard-platform.mjs linux && tauri build",
    "build:utools": "vite build --mode utools && node scripts/build-utools.mjs",
    "utools:build": "bun run build:utools"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1"
  }
}
